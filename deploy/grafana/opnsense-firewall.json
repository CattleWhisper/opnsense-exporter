        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "opnsense_firewall_memory_limit{opnsense_instance=\"$instance\", pool=\"states\"}",
          "legendFormat": "limit",
          "refId": "B",
          "range": true,
          "instant": false
