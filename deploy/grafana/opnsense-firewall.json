        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "type": "query",
        "name": "instance",
        "label": "OPNsense",
        "description": "",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(opnsense_up, opnsense_instance)",
        "query": {
          "query": "label_values(opnsense_up, opnsense_instance)",
          "refId": "instance-query",
          "qryType": 1
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {},
        "hide": 0,
        "regex": "",
        "options": []
      },
      {
        "type": "query",
        "name": "pf_interface",
        "label": "pf interface",
        "description": "",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(opnsense_firewall_in_ipv4_pass_bytes_total{opnsense_instance=\"$instance\"}, interface)",
        "query": {
          "query": "label_values(opnsense_firewall_in_ipv4_pass_bytes_total{opnsense_instance=\"$instance\"}, interface)",
          "refId": "pf_interface-query",
          "qryType": 1
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0,
        "regex": "",
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "State table",
      "collapsed": false,
      "id": 2,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "gauge",
      "title": "State table usage",
      "description": "Current states / hard limit. pf starts dropping new connections at 100 %.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "opnsense_firewall_state_table_entries{opnsense_instance=\"$instance\"} / on(opnsense_instance) opnsense_firewall_memory_limit{opnsense_instance=\"$instance\", pool=\"states\"}",
          "legendFormat": "usage",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.6
              },
              {
                "color": "red",
                "value": 0.85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "id": 3,
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 0,
        "y": 1
