    {
      "type": "timeseries",
      "title": "States",
      "description": "pf state table entries over time.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "opnsense_firewall_state_table_entries{opnsense_instance=\"$instance\"}",
          "legendFormat": "states",
          "refId": "A",
          "range": true,
          "instant": false
